rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Same owner access used by the copied project's deployed rules.
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function admin() { return request.auth != null && request.auth.token.get('admin', false) == true; }
    match /users/{uid}/{document=**} { allow read, write: if owner(uid); }
    match /profiles/{uid} { allow read: if owner(uid) || admin(); }
    match /logs/{id} { allow create: if request.auth != null; allow read: if admin(); }
  }
}
